{
  "name": "VSCode R",
  "image": "mattocci/cmdstan-zsh:4.6.1",
  "containerUser": "rstudio",
  "remoteUser": "rstudio",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "HOME": "/home/rstudio",
    "VSCODE_AGENT_FOLDER": "/home/rstudio/.vscode-server",
    "RENV_PATHS_CACHE": "/renv",
    "INSIDE_CONTAINER": "true",
    "INSIDE_DOCKER": "true",
    "TERM_PROGRAM": "vscode",
    "http_proxy": "${localEnv:HTTP_PROXY}",
    "https_proxy": "${localEnv:HTTPS_PROXY}",
    "no_proxy": "${localEnv:NO_PROXY}",
    "RENV_PATHS_PREFIX_AUTO": "TRUE"
  },
  "mounts": [
    "source=${localEnv:HOME}/renv,target=/renv,type=bind"
  ],
  "postCreateCommand": "Rscript scripts/restore.R",
  "customizations": {
    "vscode": {
      "extensions": [
        "reditorsupport.r",
        "quarto.quarto",
        "mhutchie.git-graph",
        "donjayamanne.githistory",
        "rlivings39.fzf-quick-open",
        "openai.codex",
        "anthropic.claude-code"
      ],
      "settings": {
        "r.rterm.linux": "/opt/venv/bin/radian",
        "r.rpath.linux": "/usr/local/bin/R",
        "r.sessionWatcher": true,
        "r.plot.useHttpgd": true,
        "quarto.path": "/usr/local/bin/quarto"
      }
    }
  },
  "initializeCommand": [
    "bash",
    "-c",
    "mkdir -p \"$HOME/renv\""
  ]
}
